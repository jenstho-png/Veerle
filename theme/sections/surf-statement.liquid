<section class="surf surf-statement color-{{ section.settings.color_scheme }}" id="statement-{{ section.id }}">
  <div class="surf__inner mk-in">
    {% render 'tt-logo', variant: 'golfje' %}
    {%- render 'surf-headline', text: section.settings.quote, tag: 'blockquote' -%}
    {%- if section.settings.cite != blank -%}<cite>{{ section.settings.cite }}</cite>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Surf: statement",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Kleurenschema",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote",
      "info": "*woord* = accentfont",
      "default": "Dit moet en kan stukken *comfortabeler*."
    },
    {
      "type": "text",
      "id": "cite",
      "label": "Onderschrift",
      "default": "Veerle, na weer een hike naar een verstopte spot"
    }
  ],
  "presets": [
    {
      "name": "Surf: statement"
    }
  ]
}
{% endschema %}
