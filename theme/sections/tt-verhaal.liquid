{%- assign tt_zie = true -%}
{%- if template.name == 'product' and product != blank -%}
  {%- capture tt_groep -%}{%- render 'tt-groep', type: product.type -%}{%- endcapture -%}
  {%- assign tt_groep = tt_groep | strip -%}
  {%- assign tt_toon = section.settings.toon | default: 'alle' -%}
  {%- if tt_toon == 'anders' -%}
    {%- if tt_groep == 'draagtas' -%}{%- assign tt_zie = false -%}{%- endif -%}
  {%- elsif tt_toon != 'alle' and tt_toon != tt_groep -%}
    {%- assign tt_zie = false -%}
  {%- endif -%}
{%- endif -%}
{%- if tt_zie -%}
<section class="tt tt-verhaal tt-bg--{{ section.settings.bg }}" id="tt-verhaal">
  <div class="tt-wrap tt-verhaal__grid">
    <div class="tt-verhaal__foto">{%- if section.settings.stickers -%}<div class="tt-stickers tt-stickers--verhaal" aria-hidden="true">{% render 'tt-stk', naam: 'zon' %}</div>{%- endif -%}<div class="tt-onthul">{%- render 'tt-beeld', image: section.settings.image, filename: section.settings.filename, fallback: 'tt-foto-verhaal', alt: section.settings.alt, sizes: '(min-width: 990px) 42vw, 90vw' -%}</div></div>
    <div class="tt-verhaal__tekst">
      {%- render 'tt-kop', text: section.settings.heading, tag: 'h2', class: 'tt-kop--m' -%}
      <div class="tt-verhaal__body tt-in">{{ section.settings.text }}</div>
      {%- if section.settings.naam != blank -%}<p class="tt-handtekening tt-in">{{ section.settings.naam }}</p>{%- endif -%}
      {%- if section.settings.link_label != blank -%}<a class="tt-link tt-in" href="{{ section.settings.link | default: '/pages/over-ons' }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "TT: het verhaal",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "bg",
      "label": "Achtergrond",
      "options": [
        {
          "value": "creme",
          "label": "Crème"
        },
        {
          "value": "papier",
          "label": "Papier"
        },
        {
          "value": "zand",
          "label": "Zand"
        },
        {
          "value": "deep",
          "label": "Deep"
        },
        {
          "value": "baby",
          "label": "Baby"
        },
        {
          "value": "rose",
          "label": "Rose"
        },
        {
          "value": "sunshine",
          "label": "Sunshine"
        }
      ],
      "default": "deep"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "info": "Een | is een nieuwe regel. Zet woorden tussen *sterretjes* voor het cursieve accent.",
      "default": "“Dit moet stukken|comfortabeler kunnen.”"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Losse touwtjes, spanbanden, standaardhoezen: ik heb het allemaal geprobeerd. Niets hield het lang vol.</p><p>In februari 2025 kwam er een vriend bij die net zo gek is op surfen en precies dezelfde frustratie kende. Toen zijn we de tas gewoon zelf gaan maken. Robuust, van zware stof, en mooi genoeg om mee te nemen op reis.</p>"
    },
    {
      "type": "text",
      "id": "naam",
      "label": "Ondertekening",
      "default": "Veerle"
    },
    {
      "type": "checkbox",
      "id": "stickers",
      "label": "Sticker bij de foto",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link",
      "default": "Lees het hele verhaal"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link-adres"
    },
    {
      "type": "header",
      "content": "Foto"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto"
    },
    {
      "type": "text",
      "id": "filename",
      "label": "Bestandsnaam",
      "default": "tide-tode-verhaal.jpg",
      "info": "Of upload in Content > Bestanden met precies deze naam. Tot die tijd staat er een sfeerfoto."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt-tekst",
      "default": "Op reis met een surfboard"
    },
    {
      "type": "select",
      "id": "toon",
      "label": "Tonen op de productpagina bij",
      "options": [
        {
          "value": "alle",
          "label": "Altijd"
        },
        {
          "value": "draagtas",
          "label": "Alleen draagtassen"
        },
        {
          "value": "kleding",
          "label": "Alleen kleding"
        },
        {
          "value": "accessoires",
          "label": "Alleen accessoires"
        },
        {
          "value": "surfgear",
          "label": "Alleen surfgear"
        },
        {
          "value": "anders",
          "label": "Alles behalve draagtassen"
        }
      ],
      "default": "alle",
      "info": "Alleen op productpagina's. Elders staat de sectie er altijd."
    }
  ],
  "presets": [
    {
      "name": "TT: het verhaal"
    }
  ]
}
{% endschema %}
