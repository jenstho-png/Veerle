<section class="tt tt-verhaal tt-bg--{{ section.settings.bg }}" id="tt-verhaal">
  <div class="tt-wrap tt-verhaal__grid">
    <div class="tt-verhaal__foto tt-onthul" data-tt-snelheid="-0.06">{%- render 'tt-beeld', image: section.settings.image, filename: section.settings.filename, fallback: 'tt-foto-verhaal', alt: section.settings.alt, sizes: '(min-width: 990px) 42vw, 90vw' -%}</div>
    <div class="tt-verhaal__tekst">
      {%- render 'tt-kop', text: section.settings.heading, tag: 'h2', class: 'tt-kop--m' -%}
      <div class="tt-verhaal__body tt-in">{{ section.settings.text }}</div>
      {%- if section.settings.naam != blank -%}<p class="tt-handtekening tt-in">{{ section.settings.naam }}</p>{%- endif -%}
      {%- if section.settings.link_label != blank -%}<a class="tt-link tt-in" href="{{ section.settings.link | default: '/pages/over-ons' }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TT: het verhaal",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "bg",
      "label": "Achtergrond",
      "options": [
        {
          "value": "creme",
          "label": "Crème"
        },
        {
          "value": "zand",
          "label": "Zand"
        },
        {
          "value": "deep",
          "label": "Deep"
        },
        {
          "value": "baby",
          "label": "Baby"
        }
      ],
      "default": "deep"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "info": "Een | is een nieuwe regel. Zet woorden tussen *sterretjes* voor het cursieve accent.",
      "default": "“Niets hield het vol.|*Dus maakten we|hem zelf.*”"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Lange hikes naar afgelegen spots in Australië, Midden-Amerika en Azië, met een log board onder je arm. De wax schuurt, je schouders doen pijn en op de scooter stuur je met één hand. Losse touwtjes, spanbanden, standaardhoezen: we hebben het allemaal geprobeerd.</p><p>Dus maakten we de tas die we zelf zochten. Van riders, voor riders.</p>"
    },
    {
      "type": "text",
      "id": "naam",
      "label": "Ondertekening",
      "default": "Veerle"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link",
      "default": "Lees het hele verhaal"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link-adres"
    },
    {
      "type": "header",
      "content": "Foto"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto"
    },
    {
      "type": "text",
      "id": "filename",
      "label": "Bestandsnaam",
      "default": "tide-tode-verhaal.jpg",
      "info": "Of upload in Content > Bestanden met precies deze naam. Tot die tijd staat er een sfeerfoto."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt-tekst",
      "default": "Op reis met een surfboard"
    }
  ],
  "presets": [
    {
      "name": "TT: het verhaal"
    }
  ]
}
{% endschema %}
