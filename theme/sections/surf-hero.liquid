{%- liquid
  assign layout = section.settings.layout
  assign loading = 'lazy'
  if section.index == 1
    assign loading = 'eager'
  endif
-%}
<section class="surf surf-hero surf-hero--{{ layout }} color-{{ section.settings.color_scheme }}" id="hero-{{ section.id }}">
  {%- if layout == 'full' -%}
    <div class="surf-media surf-hero__bg">
      {%- render 'surf-image',
        image: section.settings.image,
        filename: section.settings.image_filename,
        alt: section.settings.image_alt,
        sizes: '100vw',
        loading: loading
      -%}
    </div>
  {%- endif -%}

  <div class="surf__inner">
    <div class="surf-hero__grid">
      <div class="surf-hero__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="surf-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- render 'surf-headline', text: section.settings.heading, tag: 'h1' -%}
        {%- if section.settings.text != blank -%}
          <p class="surf-lead" style="margin-top: 2.8rem;">{{ section.settings.text }}</p>
        {%- endif -%}
        <div class="surf-btns">
          {%- if section.settings.btn1_label != blank -%}
            <a href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}" class="surf-btn surf-btn--primary">
              {{- section.settings.btn1_label }}
              {% render 'surf-icon', icon: 'arrow' -%}
            </a>
          {%- endif -%}
          {%- if section.settings.btn2_label != blank -%}
            <a href="{{ section.settings.btn2_link | default: '#' }}" class="surf-btn surf-btn--ghost">{{ section.settings.btn2_label }}</a>
          {%- endif -%}
        </div>
        {%- if section.blocks.size > 0 -%}
          <ul class="surf-hero__trust">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{% render 'surf-icon', icon: 'check' %}{{ block.settings.text }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if layout == 'split' -%}
        <div class="surf-media surf-hero__media">
          {%- render 'surf-image',
            image: section.settings.image,
            filename: section.settings.image_filename,
            alt: section.settings.image_alt,
            sizes: '(min-width: 990px) 45vw, 100vw',
            loading: loading
          -%}
          {%- if section.settings.badge != blank -%}
            <div class="surf-hero__badge"><i>{% render 'surf-icon', icon: 'hands' %}</i>{{ section.settings.badge }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Surf – hero",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurenschema", "default": "scheme-1" },
    { "type": "select", "id": "layout", "label": "Opmaak", "default": "split", "options": [
      { "value": "split", "label": "Tekst + foto naast elkaar" },
      { "value": "full", "label": "Foto schermvullend" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Bovenregel", "default": "Surfboard draagtas" },
    { "type": "text", "id": "heading", "label": "Kop", "info": "Zet een woord tussen *sterretjes* voor het accentfont", "default": "Handen vrij, op weg naar de *golf*" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Geen geschuur onder je arm en geen pijnlijke schouders meer. Onze draagtas neemt je board mee over duinen, rotsen en fietspaden, zodat jij alleen nog hoeft te denken aan die ene lege golf." },
    { "type": "text", "id": "btn1_label", "label": "Knop 1", "default": "Shop de tas" },
    { "type": "url", "id": "btn1_link", "label": "Link 1" },
    { "type": "text", "id": "btn2_label", "label": "Knop 2", "default": "Ons verhaal" },
    { "type": "url", "id": "btn2_link", "label": "Link 2" },
    { "type": "header", "content": "Foto" },
    { "type": "image_picker", "id": "image", "label": "Foto" },
    { "type": "text", "id": "image_filename", "label": "Bestandsnaam (SEO)", "default": "surfboard-draagtas-hike-naar-surfspot.jpg", "info": "Upload in Content → Bestanden met precies deze naam, dan verschijnt hij automatisch" },
    { "type": "text", "id": "image_alt", "label": "Alt-tekst", "default": "Surfer loopt met surfboard in draagtas op de rug naar een afgelegen surfspot" },
    { "type": "text", "id": "badge", "label": "Badge op foto", "default": "Handen vrij, ook op de fiets" }
  ],
  "blocks": [
    { "type": "usp", "name": "Voordeel", "settings": [ { "type": "text", "id": "text", "label": "Tekst", "default": "Voor elk board" } ] }
  ],
  "presets": [
    {
      "name": "Surf – hero",
      "blocks": [
        { "type": "usp", "settings": { "text": "Voor beginners- én avonturiersboards" } },
        { "type": "usp", "settings": { "text": "Past in je reisbagage" } }
      ]
    }
  ]
}
{% endschema %}
