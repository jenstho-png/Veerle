<section class="surf surf-features color-{{ section.settings.color_scheme }}" id="features-{{ section.id }}">
  <div class="surf__inner">
    <div class="surf-head surf-head--center mk-in">
      {%- if section.settings.eyebrow != blank -%}<p class="surf-eyebrow">{% render 'tt-logo', variant: 'golfje' %}{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- render 'surf-headline', text: section.settings.heading, tag: 'h2' -%}
      {%- if section.settings.text != blank -%}<p class="surf-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="surf-features__grid">
      {%- for block in section.blocks -%}
        {%- assign na = forloop.index0 | modulo: 4 -%}
        <article class="surf-card mk-optillen mk-in{% if na > 0 %} mk-na-{{ na }}{% endif %}" {{ block.shopify_attributes }}>
          <span class="surf-card__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <span class="surf-card__icon">{% render 'tt-icoon', icoon: block.settings.icon %}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Surf: voordelen",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Kleurenschema",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Bovenregel"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "default": "Gemaakt voor de weg ernaartoe"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Een boardbag beschermt je plank tijdens transport. Deze tas is gemaakt om hem te dragen."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Voordeel",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icoon",
          "default": "tas",
          "options": [
            {
              "value": "tas",
              "label": "De tas"
            },
            {
              "value": "golf",
              "label": "Golf"
            },
            {
              "value": "golfjes",
              "label": "Getij"
            },
            {
              "value": "board",
              "label": "Board"
            },
            {
              "value": "schelp",
              "label": "Schelp"
            },
            {
              "value": "zon",
              "label": "Zon"
            },
            {
              "value": "maan",
              "label": "Maan"
            },
            {
              "value": "zeester",
              "label": "Zeester"
            },
            {
              "value": "koraal",
              "label": "Koraal"
            },
            {
              "value": "palmblad",
              "label": "Palmblad"
            },
            {
              "value": "meeuw",
              "label": "Meeuw"
            },
            {
              "value": "wax",
              "label": "Wax"
            },
            {
              "value": "karabijn",
              "label": "Karabijnhaak"
            },
            {
              "value": "tij",
              "label": "Spiraal"
            },
            {
              "value": "voeten",
              "label": "Onderweg"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Draagcomfort"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Tekst"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Surf: voordelen",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "tas",
            "title": "Draagt prettig op lange tochten",
            "text": "Een brede schouderband verdeelt het gewicht. Zo heb je na een lange hike nog steeds zin om het water in te gaan."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "golf",
            "title": "Kan tegen een stootje",
            "text": "Zware, sterke stof en stevige stiksels. Gemaakt voor nat, zand, zout en ruig gebruik."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "meeuw",
            "title": "Gaat mee in het vliegtuig",
            "text": "De tas past in je bagage. Huur je op je bestemming een board, dan draag je dat gewoon in je eigen tas."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "board",
            "title": "Voor beginners en avonturiers",
            "text": "Past om de grote, vollere boards van beginners en om hardboards in verschillende maten."
          }
        }
