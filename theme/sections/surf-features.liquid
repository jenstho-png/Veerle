<section class="surf surf-features color-{{ section.settings.color_scheme }}" id="features-{{ section.id }}">
  <div class="surf__inner">
    <div class="surf-head surf-head--center surf-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="surf-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- render 'surf-headline', text: section.settings.heading, tag: 'h2' -%}
      {%- if section.settings.text != blank -%}<p class="surf-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="surf-features__grid">
      {%- for block in section.blocks -%}
        <article class="surf-card surf-reveal" {{ block.shopify_attributes }}>
          <span class="surf-card__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <span class="surf-card__icon">{% render 'surf-icon', icon: block.settings.icon %}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Surf – voordelen",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurenschema", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Bovenregel", "default": "Wat deze tas anders maakt" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Gemaakt voor de weg *ernaartoe*" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Een boardbag beschermt je plank. Deze tas draagt hem. Stevig, simpel en zonder poespas." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Voordeel",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icoon", "default": "backpack", "options": [
          { "value": "backpack", "label": "Rugzak" }, { "value": "shield", "label": "Schild" }, { "value": "plane", "label": "Vliegtuig" },
          { "value": "board", "label": "Surfboard" }, { "value": "hands", "label": "Handen" }, { "value": "bike", "label": "Fiets" },
          { "value": "drop", "label": "Druppel" }, { "value": "hook", "label": "Karabijnhaak" }, { "value": "leaf", "label": "Blad" },
          { "value": "compass", "label": "Kompas" }, { "value": "wave", "label": "Golf" }
        ] },
        { "type": "text", "id": "title", "label": "Titel", "default": "Draagcomfort" },
        { "type": "textarea", "id": "text", "label": "Tekst" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Surf – voordelen",
      "blocks": [
        { "type": "feature", "settings": { "icon": "backpack", "title": "Draagt als een rugzak", "text": "Ergonomische banden verdelen het gewicht over je rug. Lange hikes zonder pijnlijke schouders." } },
        { "type": "feature", "settings": { "icon": "shield", "title": "Zwaar weer-bestendig", "text": "Robuuste stof en dubbele stiksels die tegen nat, zand, zout en een flinke stoot kunnen." } },
        { "type": "feature", "settings": { "icon": "bike", "title": "Handen vrij op de weg", "text": "Board op je rug, handen aan het stuur. Op de fiets of scooter naar de spot, zonder gegoochel." } },
        { "type": "feature", "settings": { "icon": "plane", "title": "Reist met je mee", "text": "Opgevouwen klein genoeg voor je bagage. Huur je ter plekke een board? Je tas is er al." } }
      ]
    }
  ]
}
{% endschema %}
