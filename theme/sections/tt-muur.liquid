          "settings": {
            "vorm": "hoog",
            "fallback": "tt-foto-mood-6",
            "alt": "Board tegen een muur"
          }
        },
        {
          "type": "foto",
          "settings": {
            "vorm": "staand",
            "fallback": "tt-foto-mood-7",
            "onderschrift": "van riders voor riders",
            "alt": "Surfers op het strand"
          }
        },
        {
          "type": "foto",
          "settings": {
            "vorm": "boog",
            "fallback": "tt-foto-mood-8",
            "alt": "Kust van bovenaf"
          }
