<footer class="surf-footer color-{{ section.settings.color_scheme }} gradient">
  <div class="surf__inner">
    <div class="surf-footer__top">
      <div class="surf-footer__brand">
        {%- render 'tt-logo', variant: 'staand', label: shop.name -%}
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text }}</p>
        {%- endif -%}
        <ul class="surf-socials">
          {%- liquid
            assign socials = 'instagram,tiktok,facebook,youtube' | split: ','
          -%}
          {%- for s in socials -%}
            {%- assign key = 'social_' | append: s | append: '_link' -%}
            {%- if settings[key] != blank -%}
              <li>
                <a href="{{ settings[key] }}" target="_blank" rel="noopener" aria-label="{{ shop.name }} op {{ s | capitalize }}">
                  {%- render 'surf-icon', icon: s -%}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if section.settings.brief_heading != blank -%}
          <div class="surf-brief">
            <h2>{{ section.settings.brief_heading }}</h2>
            {%- if section.settings.brief_text != blank -%}<p>{{ section.settings.brief_text }}</p>{%- endif -%}
            {%- form 'customer', id: 'SurfBrief' -%}
              <input type="hidden" name="contact[tags]" value="newsletter,getijdenbrief">
              {%- if form.posted_successfully? -%}
                <p class="surf-form-msg">{{ section.settings.brief_success }}</p>
              {%- else -%}
                <div class="surf-signup">
                  <label class="visually-hidden" for="SurfBriefEmail">E-mailadres</label>
                  <input id="SurfBriefEmail" type="email" name="contact[email]" autocomplete="email" placeholder="jouw@email.nl" required>
                  <button type="submit" class="surf-btn surf-btn--primary">Aanmelden</button>
                </div>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>

      <div class="surf-footer__cols">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            <h2>{{ block.settings.heading }}</h2>
            {%- if block.type == 'menu' -%}
              <ul>
                {%- for i in (1..6) -%}
                  {%- assign lk = 'l' | append: i | append: '_label' -%}
                  {%- assign uk = 'l' | append: i | append: '_link' -%}
                  {%- if block.settings[lk] != blank -%}
                    <li><a href="{{ block.settings[uk] | default: '#' }}">{{ block.settings[lk] }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- else -%}
              <ul>
                {%- if block.settings.email != blank -%}
                  <li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  <li><a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a></li>
                {%- endif -%}
                {%- if block.settings.note != blank -%}
                  <li>{{ block.settings.note }}</li>
                {%- endif -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.show_word -%}
      <div class="surf-footer__word" aria-hidden="true">{% render 'tt-logo', variant: 'woord' %}</div>
    {%- endif -%}

    <div class="surf-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.legal != blank %} · {{ section.settings.legal }}{% endif %}</span>
      {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
        <ul class="surf-pay" aria-label="Betaalmethoden">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.show_credit -%}
        <a class="surf-footer__credit" href="https://www.creajt.nl/?ref=tide-tode" target="_blank" rel="noopener" title="Website gerealiseerd door CREAjt, creatief bureau uit Nijmegen">
          <span>Gerealiseerd door</span>
          <img src="https://www.creajt.nl/logo-trim.png" alt="CREAjt" width="64" height="18" loading="lazy">
        </a>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Surf: footer",
  "max_blocks": 5,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Kleurenschema",
      "default": "scheme-3"
    },
    {
      "type": "checkbox",
      "id": "show_credit",
      "label": "'Gerealiseerd door CREAjt' tonen",
      "default": true
    },
    {
      "type": "text",
      "id": "brief_heading",
      "label": "Nieuwsbrief: titel",
      "default": "De getijdenbrief"
    },
    {
      "type": "textarea",
      "id": "brief_text",
      "label": "Nieuwsbrief: tekst",
      "default": "Een paar keer per seizoen: nieuwe tassen, spots van onderweg en een kijkje achter de schermen."
    },
    {
      "type": "text",
      "id": "brief_success",
      "label": "Nieuwsbrief: bedankt",
      "default": "Je staat erop. Tot de volgende getijde."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Merktekst",
      "default": "Draagtassen voor je surfboard, van surfers voor surfers. Handen vrij op weg naar de golf."
    },
    {
      "type": "checkbox",
      "id": "show_word",
      "label": "Grote merknaam tonen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Betaalmethoden tonen",
      "default": true
    },
    {
      "type": "text",
      "id": "legal",
      "label": "Juridische regel",
      "info": "Bijv. KvK-nummer"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu-kolom",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titel",
          "default": "Shop"
        },
        {
          "type": "text",
          "id": "l1_label",
          "label": "Link 1"
        },
        {
          "type": "url",
          "id": "l1_link",
          "label": "URL 1"
        },
        {
          "type": "text",
          "id": "l2_label",
          "label": "Link 2"
        },
        {
          "type": "url",
          "id": "l2_link",
          "label": "URL 2"
        },
        {
          "type": "text",
          "id": "l3_label",
          "label": "Link 3"
        },
        {
          "type": "url",
          "id": "l3_link",
          "label": "URL 3"
        },
        {
          "type": "text",
          "id": "l4_label",
          "label": "Link 4"
        },
        {
          "type": "url",
          "id": "l4_link",
          "label": "URL 4"
        },
        {
          "type": "text",
          "id": "l5_label",
          "label": "Link 5"
        },
        {
          "type": "url",
          "id": "l5_link",
          "label": "URL 5"
        },
        {
          "type": "text",
          "id": "l6_label",
          "label": "Link 6"
        },
        {
          "type": "url",
          "id": "l6_link",
          "label": "URL 6"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titel",
          "default": "Contact"
        },
        {
          "type": "text",
          "id": "email",
          "label": "E-mail"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Telefoon"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Extra regel",
          "default": "We reageren binnen één werkdag."
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}
