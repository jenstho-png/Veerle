<section class="surf surf-merkverhaal color-{{ section.settings.color_scheme }}" id="teken-{{ section.id }}">
  <div class="surf__inner">
    <div class="surf-merkverhaal__grid">
      <div class="surf-merkverhaal__maan mk-in mk-in--zoom">{% render 'tt-logo', variant: 'maan' %}</div>
      <div class="surf-merkverhaal__tekst mk-in mk-na-1">
        {%- if section.settings.eyebrow != blank -%}<p class="surf-eyebrow">{% render 'tt-logo', variant: 'golfje' %}{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- render 'surf-headline', text: section.settings.heading, tag: 'h2' -%}
        <div class="rte surf-lead">{{ section.settings.text }}</div>
        <ol class="surf-merkverhaal__punten">
          {%- if section.settings.punt1 != blank -%}<li>{% render 'tt-logo', variant: 'maan-simpel' %}<span>{{ section.settings.punt1 }}</span></li>{%- endif -%}
          {%- if section.settings.punt2 != blank -%}<li>{% render 'tt-icoon', icoon: 'golfjes' %}<span>{{ section.settings.punt2 }}</span></li>{%- endif -%}
          {%- if section.settings.punt3 != blank -%}<li>{% render 'tt-logo', variant: 'golfje' %}<span>{{ section.settings.punt3 }}</span></li>{%- endif -%}
        </ol>
        {%- if section.settings.slot != blank -%}<p class="surf-merkverhaal__slot">{{ section.settings.slot }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Surf: ons teken",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Kleurenschema",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Bovenregel",
      "default": "Ons teken"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "default": "De maan draagt het *getij*"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Het getij bestaat omdat de maan aan de zee trekt. Twee keer per dag, overal op aarde, zonder dat iemand er iets voor hoeft te doen. Dat is wat onze tas met je board doet.</p>"
    },
    {
      "type": "text",
      "id": "punt1",
      "label": "Punt 1",
      "default": "De maan: de kracht die het water draagt. De fijne lijnen zijn de stiksels van de tas."
    },
    {
      "type": "text",
      "id": "punt2",
      "label": "Punt 2",
      "default": "De golfjes: het getij, en de drie momenten van elke sessie. Erheen, het water, terug."
    },
    {
      "type": "text",
      "id": "punt3",
      "label": "Punt 3",
      "default": "Het golfje in onze naam: de zee die Tide en Tode verbindt."
    },
    {
      "type": "text",
      "id": "slot",
      "label": "Slotregel",
      "default": "Wij dragen, jij gaat."
    }
  ],
  "presets": [
    {
      "name": "Surf: ons teken"
    }
  ]
}
{% endschema %}
