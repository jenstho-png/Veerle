<section class="surf surf-steps color-{{ section.settings.color_scheme }}" id="steps-{{ section.id }}">
  <div class="surf__inner">
    <div class="surf-head surf-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="surf-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- render 'surf-headline', text: section.settings.heading, tag: 'h2' -%}
    </div>
    <ol class="surf-steps__list">
      {%- for block in section.blocks -%}
        <li class="surf-step surf-reveal" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Surf – stappen",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurenschema", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Bovenregel", "default": "Zo werkt het" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "In drie stappen *op pad*" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Stap",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Stap" },
        { "type": "textarea", "id": "text", "label": "Tekst" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Surf – stappen",
      "blocks": [
        { "type": "step", "settings": { "title": "Board erin", "text": "Schuif je board in de tas en zet hem vast. Nat, zanderig, gewaxt: maakt niet uit." } },
        { "type": "step", "settings": { "title": "Banden om", "text": "Stel de draagbanden in op jouw lengte. Het gewicht valt op je rug, niet op je arm." } },
        { "type": "step", "settings": { "title": "Op pad", "text": "Door de duinen, over de rotsen of op de fiets. Handen vrij tot je in het water staat." } }
      ]
    }
  ]
}
{% endschema %}
