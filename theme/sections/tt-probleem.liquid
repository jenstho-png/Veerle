<section class="tt tt-probleem tt-bg--{{ section.settings.bg }}">
  <div class="tt-wrap tt-probleem__wrap">
    <div class="tt-probleem__foto tt-probleem__foto--1" data-tt-snelheid="0.12"><div class="tt-onthul">{%- render 'tt-beeld', image: section.settings.image, filename: section.settings.filename, fallback: 'tt-foto-probleem-1', alt: section.settings.alt, sizes: '(min-width: 990px) 22vw, 40vw' -%}</div>{%- render 'tt-sticker', tekst: section.settings.sticker, kleur: 'sunshine', icoon: 'voeten', class: 'tt-sticker--onder' -%}</div>
    <p class="tt-probleem__tekst" data-tt-vul>{{ section.settings.tekst | escape | replace: '*', '' }}</p>
    <div class="tt-probleem__foto tt-probleem__foto--2" data-tt-snelheid="-0.1"><div class="tt-onthul">{%- render 'tt-beeld', image: section.settings.b2_image, filename: section.settings.b2_filename, fallback: 'tt-foto-probleem-2', alt: section.settings.b2_alt, sizes: '(min-width: 990px) 22vw, 40vw' -%}</div></div>
    {%- if section.settings.slot != blank -%}<p class="tt-probleem__naam tt-in">{{ section.settings.slot }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "TT: het probleem",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "bg",
      "label": "Achtergrond",
      "options": [
        {
          "value": "creme",
          "label": "Crème"
        },
        {
          "value": "zand",
          "label": "Zand"
        },
        {
          "value": "deep",
          "label": "Deep"
        },
        {
          "value": "baby",
          "label": "Baby"
        },
        {
          "value": "rose",
          "label": "Rose"
        },
        {
          "value": "sunshine",
          "label": "Sunshine"
        }
      ],
      "default": "creme"
    },
    {
      "type": "text",
      "id": "sticker",
      "label": "Sticker op de linkerfoto",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "tekst",
      "label": "Tekst die volloopt",
      "default": "Op mijn reizen liep ik vaak een uur naar een spot, met een longboard onder mijn arm. De wax schuurde, mijn schouders deden pijn en op de scooter stuurde ik met één hand. Een dichte boardbag was ook niks: daar moet je je natte, zanderige board elke keer weer in."
    },
    {
      "type": "text",
      "id": "slot",
      "label": "Slotzin",
      "info": "Een | is een nieuwe regel. Zet woorden tussen *sterretjes* voor het cursieve accent.",
      "default": "Veerle, oprichter"
    },
    {
      "type": "header",
      "content": "Foto links"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto"
    },
    {
      "type": "text",
      "id": "filename",
      "label": "Bestandsnaam",
      "default": "tide-tode-sjouwen.jpg",
      "info": "Of upload in Content > Bestanden met precies deze naam. Tot die tijd staat er een sfeerfoto."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt-tekst",
      "default": "Board onder de arm op weg naar het strand"
    },
    {
      "type": "header",
      "content": "Foto rechts"
    },
    {
      "type": "image_picker",
      "id": "b2_image",
      "label": "Foto"
    },
    {
      "type": "text",
      "id": "b2_filename",
      "label": "Bestandsnaam",
      "default": "tide-tode-onderweg.jpg",
      "info": "Of upload in Content > Bestanden met precies deze naam. Tot die tijd staat er een sfeerfoto."
    },
    {
      "type": "text",
      "id": "b2_alt",
      "label": "Alt-tekst",
      "default": "Onderweg naar de spot"
    }
  ],
  "presets": [
    {
      "name": "TT: het probleem"
    }
  ]
}
{% endschema %}
