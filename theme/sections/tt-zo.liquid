            },
            {
              "value": "golfjes",
              "label": "Getij"
            },
            {
              "value": "board",
              "label": "Board"
            },
            {
              "value": "schelp",
              "label": "Schelp"
            },
            {
              "value": "zon",
              "label": "Zon"
            },
            {
              "value": "maan",
              "label": "Maan"
            },
            {
              "value": "zeester",
              "label": "Zeester"
            },
            {
              "value": "palmblad",
              "label": "Palmblad"
            },
            {
              "value": "meeuw",
              "label": "Meeuw"
            },
            {
              "value": "wax",
              "label": "Wax"
            },
            {
              "value": "karabijn",
              "label": "Karabijnhaak"
            },
            {
              "value": "tij",
              "label": "Spiraal"
            },
            {
              "value": "voeten",
              "label": "Onderweg"
            }
          ],
          "default": ""
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "text",
          "id": "filename",
          "label": "Bestandsnaam",
          "default": ""
        },
        {
