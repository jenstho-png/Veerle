    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "De stof, de stiksels en de schouderband van dichtbij."
    },
    {
      "type": "select",
      "id": "toon",
      "label": "Tonen op de productpagina bij",
      "options": [
        {
          "value": "alle",
          "label": "Altijd"
        },
        {
          "value": "draagtas",
          "label": "Alleen draagtassen"
        },
        {
          "value": "kleding",
          "label": "Alleen kleding"
        },
        {
          "value": "accessoires",
          "label": "Alleen accessoires"
        },
        {
          "value": "surfgear",
          "label": "Alleen surfgear"
        },
        {
          "value": "anders",
          "label": "Alles behalve draagtassen"
        }
      ],
      "default": "alle",
      "info": "Alleen op productpagina's. Elders staat de sectie er altijd."
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto (close-up, vierkant)"
        },
        {
          "type": "text",
          "id": "filename",
          "label": "Bestandsnaam",
          "info": "Of upload in Content > Bestanden met precies deze naam."
        },
        {
          "type": "text",
          "id": "titel",
          "label": "Titel",
          "default": "Detail"
        },
        {
          "type": "text",
          "id": "tekst",
          "label": "Tekst"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TT: details van de tas",
      "blocks": [
        {
          "type": "detail",
          "settings": {
            "titel": "Zware stof",
            "tekst": "Waterbestendig en gemaakt voor nat, zand en zout.",
