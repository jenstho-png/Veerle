        {
          "type": "detail",
          "settings": {
            "titel": "De tegelprint",
            "tekst": "Geweven in terracotta, dusty blue, roest en crème.",
            "filename": "tide-tode-detail-print.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
