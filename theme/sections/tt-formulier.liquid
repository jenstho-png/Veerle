<section class="tt tt-formulier tt-bg--{{ section.settings.bg }}">
  <div class="tt-wrap tt-formulier__grid">
    <div class="tt-formulier__tekst">
      {%- render 'tt-kop', text: section.settings.heading, tag: 'h1', class: 'tt-kop--l' -%}
      {%- if section.settings.text != blank -%}<div class="tt-formulier__intro tt-in">{{ section.settings.text }}</div>{%- endif -%}
      <ul class="tt-formulier__punten tt-in">
        {%- for i in (1..3) -%}
          {%- assign k = 'punt' | append: i -%}
          {%- if section.settings[k] != blank -%}<li>{{ section.settings[k] }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if section.settings.stickers -%}<div class="tt-stickers tt-stickers--formulier" aria-hidden="true">{% render 'tt-stk', naam: 'zon' %}</div>{%- endif -%}
    </div>
    <div class="tt-formulier__vak">
      {%- if section.settings.code != blank -%}
        {{ section.settings.code }}
      {%- else -%}
        <p class="tt-formulier__leeg">Plak hier de insluitcode van je ActiveCampaign-formulier: Thema aanpassen &gt; deze sectie &gt; Formuliercode.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TT: formulier",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "bg", "label": "Achtergrond", "options": [ { "value": "creme", "label": "Crème" }, { "value": "zand", "label": "Zand" }, { "value": "baby", "label": "Baby" }, { "value": "rose", "label": "Rose" } ], "default": "creme" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "10% korting op je *eerste tas*" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Schrijf je in voor de nieuwsbrief van Tide Tode. Je krijgt meteen een kortingscode in je mail, en daarna een paar keer per seizoen nieuwe prints en verhalen van onderweg.</p>" },
    { "type": "text", "id": "punt1", "label": "Punt 1", "default": "De code staat direct in je mail" },
    { "type": "text", "id": "punt2", "label": "Punt 2", "default": "Een paar mails per seizoen, niet meer" },
    { "type": "text", "id": "punt3", "label": "Punt 3", "default": "Uitschrijven kan altijd met één klik" },
    { "type": "checkbox", "id": "stickers", "label": "Sticker", "default": true },
    { "type": "liquid", "id": "code", "label": "Formuliercode", "info": "Plak hier de insluitcode uit ActiveCampaign (Website > Forms > je formulier > Integrate > Embed)." }
  ],
  "presets": [ { "name": "TT: formulier" } ]
}
{% endschema %}
