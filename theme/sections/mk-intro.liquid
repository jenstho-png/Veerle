{%- comment -%} Grote openingskop met tekst en knoppen die na elkaar opkomen. {%- endcomment -%}
<section class="mk-sectie color-{{ section.settings.color_scheme }}{% if section.settings.papier %} mk-papier{% endif %}">
  <div class="mk-wrap" style="text-align: {{ section.settings.uitlijning }};">
    {%- if section.settings.label != blank -%}
      <p class="mk-label mk-in" style="margin: 0 0 16px;">{{ section.settings.label }}</p>
    {%- endif -%}
    <h1 class="mk-hero mk-in mk-na-1">{{ section.settings.kop }}</h1>
    {%- if section.settings.tekst != blank -%}
      <div class="mk-lead mk-in mk-na-2" style="max-width: 560px; margin: 24px {% if section.settings.uitlijning == 'center' %}auto{% else %}0{% endif %} 0;">{{ section.settings.tekst }}</div>
    {%- endif -%}
    {%- if section.settings.knop_1 != blank or section.settings.knop_2 != blank -%}
      <div class="mk-in mk-na-3" style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; justify-content: {% if section.settings.uitlijning == 'center' %}center{% else %}flex-start{% endif %};">
        {%- if section.settings.knop_1 != blank -%}
          <a class="mk-knop mk-knop--vol" href="{{ section.settings.link_1 | default: '#' }}">{{ section.settings.knop_1 }} <span class="mk-pijl" aria-hidden="true">→</span></a>
        {%- endif -%}
        {%- if section.settings.knop_2 != blank -%}
          <a class="mk-knop mk-knop--rand" href="{{ section.settings.link_2 | default: '#' }}">{{ section.settings.knop_2 }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Merk: intro",
  "tag": "div",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurenschema", "default": "scheme-1" },
    { "type": "checkbox", "id": "papier", "label": "Papiertextuur", "default": true },
    { "type": "text", "id": "label", "label": "Klein label boven de kop" },
    { "type": "inline_richtext", "id": "kop", "label": "Kop", "info": "Maak een woord cursief, dan wordt het het accentwoord.", "default": "Een kop die <em>blijft</em> hangen." },
    { "type": "richtext", "id": "tekst", "label": "Tekst", "default": "<p>Eén of twee zinnen. Wat je doet, voor wie, en waarom dat ertoe doet.</p>" },
    { "type": "text", "id": "knop_1", "label": "Knop 1", "default": "Bekijk de collectie" },
    { "type": "url", "id": "link_1", "label": "Link knop 1" },
    { "type": "text", "id": "knop_2", "label": "Knop 2" },
    { "type": "url", "id": "link_2", "label": "Link knop 2" },
    { "type": "select", "id": "uitlijning", "label": "Uitlijning", "default": "center", "options": [ { "value": "left", "label": "Links" }, { "value": "center", "label": "Midden" } ] }
  ],
  "presets": [ { "name": "Merk: intro" } ]
}
{% endschema %}
