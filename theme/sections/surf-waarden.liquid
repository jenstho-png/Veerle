  "blocks": [
    {
      "type": "waarde",
      "name": "Waarde",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icoon",
          "options": [
            {
              "value": "tas",
              "label": "De tas"
            },
            {
              "value": "golf",
