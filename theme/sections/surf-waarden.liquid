<section class="surf surf--tight surf-waarden color-{{ section.settings.color_scheme }}" id="waarden-{{ section.id }}">
  <div class="surf__inner">
    <ul class="surf-waarden__lijst">
      {%- for block in section.blocks -%}
        {%- assign na = forloop.index0 | modulo: 4 -%}
        <li class="surf-waarde mk-in{% if na > 0 %} mk-na-{{ na }}{% endif %}" {{ block.shopify_attributes }}>
          {%- render 'tt-icoon', icoon: block.settings.icon -%}
          <div>
            <h3>{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Surf: waardenbalk",
  "tag": "div",
  "max_blocks": 5,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Kleurenschema",
      "default": "scheme-1"
    }
