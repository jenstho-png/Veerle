            },
            {
              "value": "schelp",
              "label": "Schelp"
            },
            {
              "value": "zon",
              "label": "Zon"
            },
            {
              "value": "maan",
              "label": "Maan"
            },
            {
              "value": "zeester",
              "label": "Zeester"
            },
            {
              "value": "koraal",
              "label": "Koraal"
            },
            {
              "value": "palmblad",
              "label": "Palmblad"
            },
            {
              "value": "meeuw",
              "label": "Meeuw"
            },
            {
              "value": "wax",
              "label": "Wax"
            },
            {
