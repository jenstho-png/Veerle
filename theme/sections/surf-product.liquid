{%- liquid
  assign p = section.settings.product
  assign variant = p.selected_or_first_available_variant
  assign media_alt = p.featured_media.alt | default: p.title
-%}
<section class="surf surf-product color-{{ section.settings.color_scheme }}" id="product-{{ section.id }}">
  <div class="surf__inner">
    <div class="surf-product__grid">
      <div class="surf-media surf-product__media mk-in mk-in--zoom">
        {%- if p.featured_media != blank and section.settings.image == blank -%}
          {%- render 'surf-image', image: p.featured_media.preview_image, alt: media_alt, sizes: '(min-width: 990px) 50vw, 100vw' -%}
        {%- else -%}
          {%- render 'surf-image',
            image: section.settings.image,
            filename: section.settings.image_filename,
            alt: section.settings.image_alt,
            sizes: '(min-width: 990px) 50vw, 100vw'
          -%}
        {%- endif -%}
      </div>

      <div class="surf-product__body mk-in mk-na-1">
        {%- if section.settings.eyebrow != blank -%}<p class="surf-eyebrow">{% render 'tt-logo', variant: 'golfje' %}{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}
          {%- render 'surf-headline', text: section.settings.heading, tag: 'h2' -%}
        {%- else -%}
          <h2>{{ p.title | default: 'De draagtas' }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="surf-lead">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- if p != blank -%}
          <p class="surf-product__price">
            {{ variant.price | money }}
            {%- if variant.compare_at_price > variant.price -%}<s>{{ variant.compare_at_price | money }}</s>{%- endif -%}
            <small>incl. btw</small>
          </p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="surf-checks">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{% render 'surf-icon', icon: 'check' %}<span>{{ block.settings.text }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if p != blank -%}
          {%- form 'product', p, class: 'surf-product__form' -%}
            {%- if p.has_only_default_variant -%}
              <input type="hidden" name="id" value="{{ variant.id }}">
            {%- else -%}
              <label class="visually-hidden" for="SurfVariant-{{ section.id }}">Kies een variant</label>
              <select name="id" id="SurfVariant-{{ section.id }}">
                {%- for v in p.variants -%}
                  <option value="{{ v.id }}"{% if v == variant %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>
                    {{ v.title }}, {{ v.price | money }}{% unless v.available %} (uitverkocht){% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            {%- endif -%}
            <button type="submit" class="surf-btn surf-btn--primary"{% unless p.available %} disabled{% endunless %}>
              {%- if p.available -%}In winkelwagen{%- else -%}Binnenkort weer op voorraad{%- endif -%}
            </button>
            <a href="{{ p.url }}" class="surf-btn surf-btn--ghost">Alle details</a>
          {%- endform -%}
        {%- else -%}
          <div class="surf-btns">
            <a href="{{ routes.all_products_collection_url }}" class="surf-btn surf-btn--primary">Bekijk de shop {% render 'surf-icon', icon: 'arrow' %}</a>
          </div>
        {%- endif -%}
        {%- if section.settings.note != blank -%}
          <p class="surf-product__note">{{ section.settings.note }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Surf: product",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Kleurenschema",
      "default": "scheme-2"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Bovenregel",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "info": "Leeg = producttitel. *woord* = accentfont",
      "default": "Eén tas in een universele *maat*"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "We beginnen met één kernmodel dat om de meeste boards past. Robuuste stof, sterke stiksels en details in messing of donker metaal. Meer varianten volgen."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Kleine regel onder de knop",
      "default": "Geen wegwerpproduct, maar een tas waar je jaren mee vooruit kunt."
    },
    {
      "type": "header",
      "content": "Foto (als het product nog geen foto heeft)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto"
    },
    {
      "type": "text",
      "id": "image_filename",
      "label": "Bestandsnaam (SEO)",
      "default": "surfboard-draagtas-kernmodel.jpg"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt-tekst",
      "default": "Surfboard draagtas kernmodel met messing details"
    }
  ],
  "blocks": [
    {
      "type": "check",
      "name": "Kenmerk",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Tekst",
          "default": "Universele maat"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Surf: product",
      "blocks": [
        {
          "type": "check",
          "settings": {
            "text": "Universele maat voor beginnersboards en hardboards"
          }
        },
        {
          "type": "check",
          "settings": {
            "text": "Brede schouderband, je handen blijven vrij"
          }
        },
        {
          "type": "check",
          "settings": {
            "text": "Sterke stof die tegen nat en zand kan"
          }
        },
        {
          "type": "check",
          "settings": {
            "text": "Past in je reisbagage"
          }
        }
      ]
    }
  ]
}
{% endschema %}
