    },
    {
      "type": "text",
      "id": "bron",
      "label": "Bron in de e-mail (leeg = paginatitel)"
    },
    {
      "type": "checkbox",
      "id": "gegevens",
      "label": "Contactwegen en gegevens tonen",
      "default": true
