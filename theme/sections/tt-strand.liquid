      "info": "Alleen op productpagina's. Elders staat de sectie er altijd."
    }
  ],
  "blocks": [
    {
      "type": "ding",
      "name": "Ding",
      "settings": [
        {
          "type": "text",
          "id": "titel",
          "label": "Titel",
          "default": "Een dop"
        },
        {
          "type": "text",
          "id": "tekst",
          "label": "Tekst"
