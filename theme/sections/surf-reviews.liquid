{%- comment -%}
  Alleen ECHTE reviews plaatsen. Bewust geen aggregateRating in structured data (Google-richtlijnen).
{%- endcomment -%}
<section class="surf surf-reviews color-{{ section.settings.color_scheme }}" id="reviews-{{ section.id }}">
  <div class="surf__inner">
    <div class="surf-head surf-head--center mk-in">
      {%- if section.settings.eyebrow != blank -%}<p class="surf-eyebrow">{% render 'tt-logo', variant: 'golfje' %}{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- render 'surf-headline', text: section.settings.heading, tag: 'h2' -%}
    </div>
    <div class="surf-reviews__grid">
      {%- for block in section.blocks -%}
        <article class="surf-review mk-in" {{ block.shopify_attributes }}>
          <div class="surf-review__top">
            <div class="surf-stars" aria-label="{{ block.settings.rating }} van 5 sterren">
              {%- for i in (1..block.settings.rating) -%}{% render 'surf-icon', icon: 'star' %}{%- endfor -%}
            </div>
            {%- if block.settings.google -%}{% render 'surf-icon', icon: 'google' %}{%- endif -%}
          </div>
          <p>{{ block.settings.text }}</p>
          <footer>{{ block.settings.name }}{% if block.settings.meta != blank %}<span>{{ block.settings.meta }}</span>{% endif %}</footer>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Surf: reviews",
  "tag": "div",
  "max_blocks": 9,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Kleurenschema",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Bovenregel",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "default": "Surfers over *de tas*"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Sterren",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Naam"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Extra regel",
          "info": "Bijv. 'Surft in Scheveningen'"
        },
        {
          "type": "checkbox",
          "id": "google",
          "label": "Google-logo tonen",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Surf: reviews"
    }
  ]
}
{% endschema %}
