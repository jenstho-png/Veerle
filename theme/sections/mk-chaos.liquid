{%- comment -%}
  Berichtjes-chaos: losse berichten rond een telefoon die tijdens het
  scrollen in het scherm opgaan, terwijl de kop van probleem naar
  oplossing wisselt. Gepinde sectie (260vh), --p komt uit mk-stijl.js.
{%- endcomment -%}
<section class="mk-chaos color-{{ section.settings.color_scheme }}{% if section.settings.papier %} mk-papier{% endif %}" data-mk-scrub>
  <div class="mk-chaos__podium">
    <div class="mk-chaos__koppen">
      <div class="mk-chaos__voor">
        <h2 class="mk-statement">{{ section.settings.kop_voor }}</h2>
        {%- if section.settings.sub_voor != blank -%}<p>{{ section.settings.sub_voor }}</p>{%- endif -%}
      </div>
      <div class="mk-chaos__na">
        <h2 class="mk-statement">{{ section.settings.kop_na }}</h2>
        {%- if section.settings.sub_na != blank -%}<p>{{ section.settings.sub_na }}</p>{%- endif -%}
      </div>
    </div>
    <div class="mk-chaos__vlak">
      <div class="mk-chaos__midden">
        <div class="mk-telefoon">
          <div class="mk-telefoon-scherm">
            {%- if section.settings.beeld != blank -%}
              {{ section.settings.beeld | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '250px', alt: section.settings.beeld.alt }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'mk-plek' }}
            {%- endif -%}
          </div>
        </div>
      </div>
      {%- for block in section.blocks -%}
        {%- case block.settings.icoon -%}
          {%- when 'mail' -%}{%- capture pad -%}M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2m0 2v.5l8 5 8-5V6H4m0 12h16V8l-8 5-8-5v10Z{%- endcapture -%}
          {%- when 'download' -%}{%- capture pad -%}M5 20h14v-2H5v2M19 9h-4V3H9v6H5l7 7 7-7Z{%- endcapture -%}
          {%- when 'beeld' -%}{%- capture pad -%}M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2m0 14h16v-3l-4.5-4.5-3.5 4-2.5-2L4 15v3M8.5 9A1.5 1.5 0 1 0 7 7.5 1.5 1.5 0 0 0 8.5 9Z{%- endcapture -%}
          {%- when 'bon' -%}{%- capture pad -%}M18 17H6v-2h12v2zm0-4H6v-2h12v2zm0-4H6V7h12v2zM3 22l1.5-1.5L6 22l1.5-1.5L9 22l1.5-1.5L12 22l1.5-1.5L15 22l1.5-1.5L18 22l1.5-1.5L21 22V2l-1.5 1.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2 4.5 3.5 3 2v20z{%- endcapture -%}
          {%- when 'telefoon' -%}{%- capture pad -%}M17 1.01 7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z{%- endcapture -%}
          {%- when 'pakket' -%}{%- capture pad -%}M12 2 3 6.5v11L12 22l9-4.5v-11L12 2m0 2.2 6.6 3.3L12 10.8 5.4 7.5 12 4.2M5 9.1l6 3v7.7l-6-3V9.1m8 10.7v-7.7l6-3v7.7l-6 3Z{%- endcapture -%}
          {%- else -%}{%- capture pad -%}M4 2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H8l-4 4V4a2 2 0 0 1 2-2m3 6v2h10V8H7m0 4v2h7v-2H7Z{%- endcapture -%}
        {%- endcase -%}
        <div class="mk-bubbel-plek" style="--x: {{ block.settings.x }}; --y: {{ block.settings.y }}; --r: {{ block.settings.r }}; --k: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <div class="mk-bubbel">
            <span class="mk-bubbel__ic"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="{{ pad }}"/></svg></span>
            <span>
              {%- if block.settings.van != blank -%}<span class="mk-bubbel__van">{{ block.settings.van }}</span>{%- endif -%}
              <span class="mk-bubbel__tekst">{{ block.settings.tekst }}</span>
            </span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .mk-chaos .mk-plek { position: absolute; inset: 0; width: 100%; height: 100%; background: var(--mk-vulling); }
</style>

{% schema %}
{
  "name": "Merk: berichtjes-chaos",
  "tag": "div",
  "max_blocks": 10,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleurenschema", "default": "scheme-1" },
    { "type": "checkbox", "id": "papier", "label": "Papiertextuur", "default": true },
    { "type": "inline_richtext", "id": "kop_voor", "label": "Kop: het probleem", "info": "Maak een woord cursief, dan wordt het het accentwoord.", "default": "Te veel losse <em>berichtjes?</em>" },
    { "type": "text", "id": "sub_voor", "label": "Onder de eerste kop", "default": "Herkenbaar? Scroll maar door." },
    { "type": "inline_richtext", "id": "kop_na", "label": "Kop: de oplossing", "default": "Eén plek. Eén <em>overzicht.</em>" },
    { "type": "text", "id": "sub_na", "label": "Onder de tweede kop", "default": "Vertel hier in één zin hoe het daarna gaat." },
    { "type": "image_picker", "id": "beeld", "label": "Scherm in de telefoon", "info": "1290 × 2796 (iPhone-verhouding)." }
  ],
  "blocks": [
    {
      "type": "bericht",
      "name": "Bericht",
      "settings": [
        { "type": "text", "id": "tekst", "label": "Bericht", "default": "Is mijn bestelling al onderweg?" },
        { "type": "text", "id": "van", "label": "Van", "default": "Mail van een klant" },
        { "type": "select", "id": "icoon", "label": "Icoon", "default": "chat", "options": [
          { "value": "chat", "label": "Bericht" }, { "value": "mail", "label": "Mail" }, { "value": "telefoon", "label": "Telefoon" },
          { "value": "download", "label": "Download" }, { "value": "beeld", "label": "Afbeelding" }, { "value": "bon", "label": "Bon" }, { "value": "pakket", "label": "Pakket" }
        ] },
        { "type": "range", "id": "x", "label": "Plek links/rechts", "min": -40, "max": 40, "step": 1, "default": -30 },
        { "type": "range", "id": "y", "label": "Plek boven/onder", "min": -30, "max": 32, "step": 1, "default": -16 },
        { "type": "range", "id": "r", "label": "Scheef", "min": -8, "max": 8, "step": 1, "default": -5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Merk: berichtjes-chaos",
      "blocks": [
        { "type": "bericht", "settings": { "tekst": "Is mijn bestelling al onderweg?", "van": "Mail van een klant", "icoon": "pakket", "x": -30, "y": -16, "r": -5 } },
        { "type": "bericht", "settings": { "tekst": "De link werkt niet meer, kun je hem nog een keer sturen?", "van": "Mail van een klant", "icoon": "download", "x": 29, "y": -19, "r": 4 } },
        { "type": "bericht", "settings": { "tekst": "Welke maat moet ik nemen?", "van": "Bericht van een klant", "icoon": "chat", "x": -33, "y": 8, "r": 3 } },
        { "type": "bericht", "settings": { "tekst": "Welke kleur bedoel je precies?", "van": "Bericht van een klant", "icoon": "beeld", "x": 31, "y": 6, "r": -4 } },
        { "type": "bericht", "settings": { "tekst": "Ik heb de bon niet gekregen", "van": "Mail van een klant", "icoon": "bon", "x": -24, "y": 29, "r": -3 } },
        { "type": "bericht", "settings": { "tekst": "Kunnen we even bellen?", "van": "Gemist gesprek", "icoon": "telefoon", "x": 26, "y": 30, "r": 5 } }
      ]
    }
  ]
}
{% endschema %}
