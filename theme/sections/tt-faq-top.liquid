<section class="tt tt-faqtop tt-bg--{{ section.settings.bg }}" data-tt-faqtop>
  <div class="tt-wrap">
    {%- render 'tt-kop', text: section.settings.heading, tag: 'h1', class: 'tt-kop--l' -%}
    {%- if section.settings.text != blank -%}<p class="tt-faqtop__tekst tt-in">{{ section.settings.text }}</p>{%- endif -%}
    <div class="tt-faqtop__zoek tt-in">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <label class="visually-hidden" for="tt-faq-zoek-{{ section.id }}">{{ section.settings.placeholder }}</label>
      <input id="tt-faq-zoek-{{ section.id }}" type="search" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="off" data-tt-faqzoek>
    </div>
    <nav class="tt-faqtop__onderwerpen tt-in" aria-label="Onderwerpen" data-tt-faqnav></nav>
    <p class="tt-faqtop__uitslag" data-tt-faquitslag data-geen="{{ section.settings.geen | escape }}" aria-live="polite" hidden></p>
  </div>
</section>

{% schema %}
{
  "name": "TT: vragen zoeken",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "bg", "label": "Achtergrond", "options": [ { "value": "creme", "label": "Crème" }, { "value": "papier", "label": "Papier" }, { "value": "zand", "label": "Zand" } ], "default": "creme" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Veelgestelde *vragen*" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Zoek je vraag of kies een onderwerp." },
    { "type": "text", "id": "placeholder", "label": "Tekst in het zoekveld", "default": "Zoek een vraag, bijvoorbeeld softtop" },
    { "type": "text", "id": "geen", "label": "Tekst als er niets gevonden is", "default": "Niets gevonden. Stuur ons gerust een bericht." }
  ],
  "presets": [ { "name": "TT: vragen zoeken" } ]
}
{% endschema %}
