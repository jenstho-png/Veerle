    },
    {
      "type": "header",
      "content": "Productfoto 1 (zolang het product geen foto's heeft)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto"
    },
    {
      "type": "text",
      "id": "filename",
      "label": "Bestandsnaam",
      "default": "tide-tode-draagtas-1.jpg",
      "info": "Of upload in Content > Bestanden met precies deze naam. Tot die tijd staat er een sfeerfoto."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt-tekst",
      "default": "De Tide-Tode draagtas met board"
    },
    {
      "type": "header",
      "content": "Productfoto 2"
    },
    {
      "type": "image_picker",
      "id": "b2_image",
      "label": "Foto"
    },
    {
      "type": "text",
      "id": "b2_filename",
      "label": "Bestandsnaam",
      "default": "tide-tode-draagtas-2.jpg",
      "info": "Of upload in Content > Bestanden met precies deze naam. Tot die tijd staat er een sfeerfoto."
    },
    {
      "type": "text",
      "id": "b2_alt",
      "label": "Alt-tekst",
      "default": "Board op de rug onderweg naar de spot"
    }
  ],
  "blocks": [
    {
      "type": "punt",
      "name": "Voordeel",
      "settings": [
        {
          "type": "text",
          "id": "tekst",
          "label": "Tekst",
          "default": "Handen vrij"
        }
      ]
    },
    {
      "type": "detail",
      "name": "Uitklapper",
      "settings": [
        {
          "type": "text",
          "id": "titel",
          "label": "Titel",
          "default": "Materiaal"
        },
        {
          "type": "richtext",
          "id": "tekst",
          "label": "Tekst",
          "default": "<p>Tekst</p>"
