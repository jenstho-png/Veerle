    },
    {
      "type": "header",
      "content": "Vertrouwen onder de knop"
    },
    {
      "type": "text",
      "id": "v1",
      "label": "Regel 1",
      "default": "Verzending door heel Europa"
    },
    {
      "type": "text",
      "id": "v2",
      "label": "Regel 2",
      "default": "14 dagen bedenktijd"
    },
    {
      "type": "text",
      "id": "v3",
