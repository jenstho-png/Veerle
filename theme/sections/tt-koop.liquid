    }
  ],
  "presets": [
    {
      "name": "TT: kopen",
      "blocks": [
        {
          "type": "punt",
          "settings": {
            "tekst": "Past op softtops en vollere boards én op hardboards"
          }
        },
        {
          "type": "punt",
          "settings": {
            "tekst": "Gewicht goed verdeeld over je rug, niet op één schouder"
