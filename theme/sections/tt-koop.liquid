      "name": "Uitklapper",
      "settings": [
        {
          "type": "text",
          "id": "titel",
          "label": "Titel",
          "default": "Materiaal"
        },
        {
          "type": "richtext",
          "id": "tekst",
          "label": "Tekst",
          "default": "<p>Tekst</p>"
        },
        {
          "type": "select",
          "id": "toon",
          "label": "Tonen bij",
          "options": [
            {
              "value": "alle",
              "label": "Altijd"
            },
            {
              "value": "draagtas",
              "label": "Alleen draagtassen"
            },
            {
              "value": "kleding",
              "label": "Alleen kleding"
            },
            {
              "value": "accessoires",
              "label": "Alleen accessoires"
            },
            {
              "value": "surfgear",
              "label": "Alleen surfgear"
            },
            {
              "value": "anders",
              "label": "Alles behalve draagtassen"
            }
          ],
          "default": "alle"
        }
      ]
    }
  ],
  "presets": [
