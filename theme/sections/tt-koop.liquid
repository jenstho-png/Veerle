        },
        {
          "value": "papier",
          "label": "Papier"
        },
        {
          "value": "zand",
          "label": "Zand"
        },
        {
          "value": "deep",
          "label": "Deep"
        },
        {
          "value": "baby",
          "label": "Baby"
        },
        {
          "value": "rose",
          "label": "Rose"
        },
        {
          "value": "sunshine",
          "label": "Sunshine"
        }
