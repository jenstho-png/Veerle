{%- assign tt_zie = true -%}
{%- if template.name == 'product' and product != blank -%}
  {%- capture tt_groep -%}{%- render 'tt-groep', type: product.type -%}{%- endcapture -%}
  {%- assign tt_groep = tt_groep | strip -%}
  {%- assign tt_toon = section.settings.toon | default: 'alle' -%}
  {%- if tt_toon == 'anders' -%}
    {%- if tt_groep == 'draagtas' -%}{%- assign tt_zie = false -%}{%- endif -%}
  {%- elsif tt_toon != 'alle' and tt_toon != tt_groep -%}
    {%- assign tt_zie = false -%}
  {%- endif -%}
{%- endif -%}
{%- if tt_zie -%}
{%- liquid
  assign p = section.settings.product
  if p == blank and template.name == 'product' and product != blank
    assign p = product
  endif
  if p == blank
    assign p = settings.tt_product
  endif
-%}
<section class="tt tt-slot">
  <div class="tt-slot__foto">{%- render 'tt-beeld', image: section.settings.image, filename: section.settings.filename, fallback: 'tt-foto-slot', alt: section.settings.alt, sizes: '100vw' -%}</div>
  <div class="tt-slot__inhoud tt-wrap">
    <div class="tt-slot__maan tt-in">{% render 'tt-logo', variant: 'maan' %}</div>
    {%- render 'tt-kop', text: section.settings.heading, tag: 'h2', class: 'tt-kop--xl' -%}
    <div class="tt-knoppen tt-in">
      <a class="tt-knop tt-knop--licht" href="{% if section.settings.btn_link != blank %}{{ section.settings.btn_link }}{% elsif p != blank %}{{ p.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ section.settings.btn_label }}<span aria-hidden="true">→</span></a>
      {%- if section.settings.link2_label != blank -%}<a class="tt-link" href="{{ section.settings.link2_url | default: routes.all_products_collection_url }}">{{ section.settings.link2_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "TT: slot",
  "tag": "div",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leeg = het product uit Thema-instellingen > Tide-Tode."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "info": "Een | is een nieuwe regel. Zet woorden tussen *sterretjes* voor het cursieve accent.",
      "default": "Tot in|het water"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Knop",
      "default": "Bestel de draagtas"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Knop-link"
    },
    {
      "type": "text",
      "id": "link2_label",
      "label": "Tweede link",
      "default": "Of bekijk de hele shop"
    },
    {
      "type": "text",
      "id": "link2_url",
      "label": "Tweede link (adres)",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Foto"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto"
    },
    {
      "type": "text",
      "id": "filename",
      "label": "Bestandsnaam",
      "default": "tide-tode-slot.jpg",
      "info": "Of upload in Content > Bestanden met precies deze naam. Tot die tijd staat er een sfeerfoto."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt-tekst",
      "default": "Zee bij zonsondergang"
    },
    {
      "type": "select",
      "id": "toon",
      "label": "Tonen op de productpagina bij",
      "options": [
        {
          "value": "alle",
          "label": "Altijd"
        },
        {
          "value": "draagtas",
          "label": "Alleen draagtassen"
        },
        {
          "value": "kleding",
          "label": "Alleen kleding"
        },
        {
          "value": "accessoires",
          "label": "Alleen accessoires"
        },
        {
          "value": "surfgear",
          "label": "Alleen surfgear"
        },
        {
          "value": "anders",
          "label": "Alles behalve draagtassen"
        }
      ],
      "default": "alle",
      "info": "Alleen op productpagina's. Elders staat de sectie er altijd."
    }
  ],
  "presets": [
    {
      "name": "TT: slot"
    }
  ]
}
{% endschema %}
