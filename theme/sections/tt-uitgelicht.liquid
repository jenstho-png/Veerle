{%- assign p = all_products[section.settings.handle] -%}
<section class="tt tt-uit tt-bg--{{ section.settings.bg }}" data-tt-uit>
  <div class="tt-wrap tt-uit__grid">
    <div class="tt-uit__beeld">
      <div class="tt-uit__foto tt-onthul">
        {%- if p != blank and p.featured_media -%}
          {{ p.featured_media | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 44vw, 92vw', widths: '600, 900, 1200, 1400', alt: '', class: 'tt-beeld__img' }}
        {%- else -%}
          {%- render 'tt-beeld', fallback: section.settings.fallback, alt: '', sizes: '(min-width: 990px) 44vw, 92vw' -%}
        {%- endif -%}
      </div>
      {%- if section.settings.stickers -%}
        <div class="tt-stickers tt-stickers--uit" aria-hidden="true">{% render 'tt-stk', naam: 'draagtas' %}</div>
        <div class="tt-stickers tt-stickers--uit2" aria-hidden="true">{% render 'tt-stk', naam: 'zon' %}</div>
      {%- endif -%}
    </div>
    <div class="tt-uit__tekst">
      {%- render 'tt-kop', text: section.settings.heading, tag: 'h2', class: 'tt-kop--l' -%}
      {%- if section.settings.text != blank -%}<p class="tt-uit__pitch tt-in">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        {%- assign eerste = section.blocks.first -%}
        <p class="tt-uit__nu tt-in" aria-live="polite"><span data-tt-uit-nr>01</span><b data-tt-uit-naam>{{ eerste.settings.naam }}</b></p>
        <ul class="tt-uit__ontwerpen tt-in" role="list">
          {%- liquid
            assign toon = section.blocks.size
            assign totaal = collections['draagtassen'].products_count | default: 0
            if totaal == 0
              assign totaal = section.settings.totaal
            endif
            assign meer = totaal | minus: toon | plus: 1
            if meer > 1
              assign toon = toon | minus: 1
            endif
          -%}
          {%- for block in section.blocks -%}
            {%- assign bp = all_products[block.settings.handle] -%}
            {%- if forloop.index > toon -%}
              <li {{ block.shopify_attributes }}>
                <a class="tt-uit__meer" href="{{ section.settings.link2 | default: '/collections/draagtassen' }}" aria-label="Nog {{ meer }} ontwerpen bekijken">
                  {%- if bp != blank and bp.featured_media -%}
                    {{ bp.featured_media | image_url: width: 240 | image_tag: loading: 'lazy', sizes: '90px', widths: '120, 240', alt: '' }}
                  {%- else -%}
                    <img src="{{ block.settings.fallback | append: '-800.jpg' | asset_url }}" alt="" width="120" height="120" loading="lazy">
                  {%- endif -%}
                  <span>+{{ meer }}</span>
                </a>
              </li>
              {%- continue -%}
            {%- endif -%}
            {%- if bp != blank and bp.featured_media -%}
              {%- assign groot = bp.featured_media | image_url: width: 1400 -%}
            {%- else -%}
              {%- assign groot = block.settings.fallback | append: '.jpg' | asset_url -%}
            {%- endif -%}
            <li {{ block.shopify_attributes }}>
              <button type="button" class="{% if forloop.first %}is-actief{% endif %}" data-tt-groot="{{ groot }}" data-naam="{{ block.settings.naam | escape }}" data-nr="{{ forloop.index | prepend: '0' | slice: -2, 2 }}" data-url="{% if bp != blank %}{{ bp.url }}{% else %}/products/{{ block.settings.handle }}{% endif %}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                {%- if bp != blank and bp.featured_media -%}
                  {{ bp.featured_media | image_url: width: 240 | image_tag: loading: 'lazy', sizes: '90px', widths: '120, 240', alt: '' }}
                {%- else -%}
                  {%- assign klein = block.settings.fallback | append: '-800.jpg' | asset_url -%}
                  <img src="{{ klein }}" alt="" width="120" height="120" loading="lazy">
                {%- endif -%}
                <span class="visually-hidden">{{ block.settings.naam }}</span>
              </button>
            </li>
          {%- endfor -%}
        </ul>
        {%- assign eb = all_products[eerste.settings.handle] -%}
        <div class="tt-knoppen tt-in">
          {%- if section.settings.btn_label != blank -%}<a class="tt-knop" data-tt-uit-link href="{% if eb != blank %}{{ eb.url }}{% else %}/products/{{ eerste.settings.handle }}{% endif %}">{{ section.settings.btn_label }}<span aria-hidden="true">→</span></a>{%- endif -%}
          {%- if section.settings.link2_label != blank -%}<a class="tt-link" href="{{ section.settings.link2 | default: '/collections/draagtassen' }}">{{ section.settings.link2_label }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TT: uitgelicht product",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "bg", "label": "Achtergrond", "options": [ { "value": "creme", "label": "Crème" }, { "value": "papier", "label": "Papier" }, { "value": "zand", "label": "Zand" }, { "value": "baby", "label": "Baby" }, { "value": "rose", "label": "Rose" } ], "default": "creme" },
    { "type": "text", "id": "handle", "label": "Handle van het product", "default": "draagtas-tegel" },
    { "type": "text", "id": "fallback", "label": "Themafoto zolang het product er niet is", "default": "tt-product-1" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Kies je *ontwerp*" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Elke print zit op dezelfde stevige tas. Kies wat bij jouw board past." },
    { "type": "number", "id": "totaal", "label": "Aantal tassen als de collectie nog leeg is", "default": 9 },
    { "type": "checkbox", "id": "stickers", "label": "Stickers op de foto", "default": true },
    { "type": "text", "id": "btn_label", "label": "Knop", "default": "Bekijk dit ontwerp" },
    { "type": "text", "id": "link2_label", "label": "Tweede link", "default": "Alle ontwerpen" },
    { "type": "text", "id": "link2", "label": "Adres tweede link", "default": "/collections/draagtassen" }
  ],
  "blocks": [
    {
      "type": "ontwerp",
      "name": "Ontwerp",
      "settings": [
        { "type": "text", "id": "naam", "label": "Naam", "default": "Tegel" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "draagtas-tegel" },
        { "type": "text", "id": "fallback", "label": "Themafoto", "default": "tt-p-draagtas-tegel" }
      ]
    }
  ],
  "presets": [ { "name": "TT: uitgelicht product" } ]
}
{% endschema %}
