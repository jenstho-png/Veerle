{%- capture regels -%}
  {%- for t in (1..3) -%}
    {%- assign k = 'tekst' -%}{%- if t > 1 -%}{%- assign k = 'tekst' | append: t -%}{%- endif -%}
    {%- if section.settings[k] != blank -%}<span class="surf-balk__item">{{ section.settings[k] }}</span><span class="surf-balk__ster" aria-hidden="true">{%- case t -%}{%- when 1 -%}{% render 'tt-icoon', icoon: 'zon' %}{%- when 2 -%}{% render 'tt-icoon', icoon: 'golf' %}{%- else -%}{% render 'tt-icoon', icoon: 'schelp' %}{%- endcase -%}</span>{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
<div class="surf-balk">
  {%- if section.settings.link != blank -%}<a class="surf-balk__link" href="{{ section.settings.link }}">{%- endif -%}
  <div class="surf-balk__baan">
    <div class="surf-balk__spoor">{{ regels }}{{ regels }}</div>
    <div class="surf-balk__spoor" aria-hidden="true">{{ regels }}{{ regels }}</div>
  </div>
  {%- if section.settings.link != blank -%}</a>{%- endif -%}
</div>

{% schema %}
{
  "name": "Surf: merkbalk",
  "settings": [
    { "type": "text", "id": "tekst", "label": "Tekst", "default": "Van surfers, voor surfers" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "tekst2", "label": "Tekst 2", "default": "Handen vrij op weg naar de golf" },
    { "type": "text", "id": "tekst3", "label": "Tekst 3", "default": "Ontstaan op surftrips in Australië" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
