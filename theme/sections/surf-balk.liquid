<div class="surf-balk">
  <div class="surf-balk__inner">
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{{ section.settings.tekst }}</a>{%- else -%}<span>{{ section.settings.tekst }}</span>{%- endif -%}
    {%- if section.settings.tekst2 != blank -%}
      <span class="surf-balk__extra"><span>{{ section.settings.tekst2 }}</span></span>
    {%- endif -%}
    {%- if section.settings.tekst3 != blank -%}
      <span class="surf-balk__extra"><span>{{ section.settings.tekst3 }}</span></span>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Surf: merkbalk",
  "settings": [
    { "type": "text", "id": "tekst", "label": "Tekst", "default": "Van surfers, voor surfers" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "tekst2", "label": "Tekst 2 (alleen desktop)", "default": "Handen vrij op weg naar de golf" },
    { "type": "text", "id": "tekst3", "label": "Tekst 3 (alleen desktop)", "default": "Ontstaan op surftrips in Australië" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
