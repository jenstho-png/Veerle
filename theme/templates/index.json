        "detail-4": {
          "type": "detail",
          "settings": {
            "titel": "Wat past erin",
            "tekst": "<p>Eén universele maat. Van de grote softtop waar je op leert surfen tot je hardboard voor de verstopte spot.</p>"
          }
        },
        "detail-5": {
          "type": "detail",
          "settings": {
            "titel": "Materiaal",
            "tekst": "<p>Zware, waterbestendige stof en sterke stiksels. Gemaakt om jaren mee te gaan, niet voor één zomer.</p>"
          }
        },
        "detail-6": {
          "type": "detail",
          "settings": {
            "titel": "Verzending en retour",
            "tekst": "<p>We versturen door heel Europa. Past hij toch niet bij je? Je hebt 14 dagen bedenktijd.</p>"
          }
        }
      },
