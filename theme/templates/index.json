          }
        },
        "detail-6": {
          "type": "detail",
          "settings": {
            "titel": "Verzending en retour",
            "tekst": "<p>We versturen door heel Europa. Past hij toch niet bij je? Je hebt 14 dagen bedenktijd.</p>"
          }
