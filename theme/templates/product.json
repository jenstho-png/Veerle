{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "features": {
      "type": "surf-features",
      "settings": {
        "color_scheme": "scheme-2",
        "eyebrow": ""
      },
      "blocks": {
        "feature-1": {
          "type": "feature",
          "settings": {
            "icon": "tas",
            "title": "Draagt prettig op lange tochten",
            "text": "Ergonomische banden verdelen het gewicht. Zo heb je na een lange hike nog steeds zin om het water in te gaan."
          }
        },
        "feature-2": {
          "type": "feature",
          "settings": {
            "icon": "golf",
            "title": "Kan tegen een stootje",
            "text": "Zware, sterke stof en stevige stiksels. Gemaakt voor nat, zand, zout en ruig gebruik."
          }
        },
        "feature-3": {
          "type": "feature",
          "settings": {
            "icon": "meeuw",
            "title": "Gaat mee in het vliegtuig",
            "text": "De tas past in je bagage. Huur je op je bestemming een board, dan draag je dat gewoon in je eigen tas."
          }
        },
        "feature-4": {
          "type": "feature",
          "settings": {
            "icon": "board",
            "title": "Voor beginners en avonturiers",
            "text": "Past om de grote, vollere boards van beginners en om hardboards in verschillende maten."
          }
        }
      },
      "block_order": [
        "feature-1",
        "feature-2",
        "feature-3",
        "feature-4"
      ]
    },
    "faq": {
      "type": "surf-faq",
      "settings": {
        "btn_link": "shopify://pages/contact",
        "eyebrow": ""
      },
      "blocks": {
        "qa-1": {
          "type": "qa",
          "settings": {
            "question": "Welke surfboards passen in de tas?",
            "answer": "<p>We beginnen met één kernmodel in een universele maat. Die past om de grote, vollere boards waar veel beginners op surfen en om hardboards in verschillende maten. Later komen er meer varianten bij.</p>"
          }
        },
        "qa-2": {
          "type": "qa",
          "settings": {
            "question": "Kan ik de tas meenemen in het vliegtuig?",
            "answer": "<p>Ja. De tas past in je bagage. Huur je op je bestemming een board, dan neem je dat in je eigen tas mee naar de spot.</p>"
          }
        },
        "qa-3": {
          "type": "qa",
          "settings": {
            "question": "Kan ik ermee fietsen of op de scooter?",
            "answer": "<p>Daar is hij juist voor bedacht. Je board zit op je rug, dus je hebt allebei je handen vrij voor het stuur.</p>"
          }
        },
        "qa-4": {
          "type": "qa",
          "settings": {
            "question": "Wat is het verschil met een boardbag?",
            "answer": "<p>Een boardbag is een dichte hoes die je board beschermt tijdens transport. Daar moet je je natte, zanderige board na elke sessie weer in proppen. Onze tas is gemaakt om je board te dragen: naar de spot en weer terug.</p>"
          }
        },
        "qa-5": {
          "type": "qa",
          "settings": {
            "question": "Zitten er lussen of karabijnhaken aan?",
            "answer": "<p>Het eerste model houden we bewust simpel. Lussen en karabijnhaken om extra spullen aan de tas te hangen komen op een later model. Stevige karabijnhaken komen ook los in de shop.</p>"
          }
        },
        "qa-6": {
          "type": "qa",
          "settings": {
            "question": "Verkopen jullie ook andere spullen?",
            "answer": "<p>Naast de tas komen er waxblokjes en karabijnhaken. In een later stadium volgen t-shirts.</p>"
          }
        }
      },
      "block_order": [
        "qa-1",
        "qa-2",
        "qa-3",
        "qa-4",
        "qa-5",
        "qa-6"
      ]
    },
    "waarden": {
      "type": "surf-waarden",
      "settings": {
        "color_scheme": "scheme-2"
      },
      "blocks": {
        "waarde-1": {
          "type": "waarde",
          "settings": {
            "icon": "tas",
            "title": "Handen vrij",
            "text": "Je board op je rug, je handen aan het stuur."
          }
        },
        "waarde-2": {
          "type": "waarde",
          "settings": {
            "icon": "golf",
            "title": "Kan tegen nat en zand",
            "text": "Zware stof, stevige stiksels."
          }
        },
        "waarde-3": {
          "type": "waarde",
          "settings": {
            "icon": "meeuw",
            "title": "Gaat mee op reis",
            "text": "Past in je bagage, ook voor een huurboard."
          }
        },
        "waarde-4": {
          "type": "waarde",
          "settings": {
            "icon": "board",
            "title": "Voor elk board",
            "text": "Van softtop tot hardboard."
          }
        }
      },
      "block_order": [
        "waarde-1",
        "waarde-2",
        "waarde-3",
        "waarde-4"
      ]
    }
  },
  "order": [
    "main",
    "waarden",
    "features",
    "disclosures",
    "faq",
    "related-products"
  ]
}