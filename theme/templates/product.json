        "detail-4": {
          "type": "detail",
          "settings": {
            "titel": "Wat past erin",
            "tekst": "<p>Eén maat voor softtops en hardboards. In de <a href=\"/pages/maatwijzer\">maatwijzer</a> zie je welke boards passen.</p>",
            "toon": "draagtas"
          }
        },
        "detail-5": {
          "type": "detail",
          "settings": {
            "titel": "Materiaal",
            "tekst": "<p>Zware, waterbestendige stof en sterke stiksels.</p>",
            "toon": "draagtas"
          }
        },
        "detail-6": {
          "type": "detail",
          "settings": {
            "titel": "Verzending en retour",
            "tekst": "<p>We versturen door heel Europa. Je hebt 14 dagen bedenktijd.</p>"
          }
        },
        "detail-kleding-1": {
          "type": "detail",
          "settings": {
            "titel": "Maat en pasvorm",
            "tekst": "<p>Twijfel je tussen twee maten? In de <a href=\"/pages/maatwijzer\">maatwijzer</a> staan de maten per product, in centimeters.</p>",
            "toon": "kleding"
          }
        },
        "detail-kleding-2": {
          "type": "detail",
          "settings": {
            "titel": "Materiaal en onderhoud",
            "tekst": "<p>Was op 30 graden, binnenstebuiten en met gelijke kleuren. Niet in de droger en niet strijken op de print. Zo blijft hij jaren mooi.</p>",
            "toon": "kleding"
          }
        },
        "detail-acc-1": {
          "type": "detail",
          "settings": {
            "titel": "Onderhoud",
            "tekst": "<p>Zand en zout spoel je eruit met zoet water. Daarna laten drogen in de schaduw.</p>",
            "toon": "accessoires"
          }
        },
        "detail-gear-1": {
          "type": "detail",
          "settings": {
            "titel": "Zo gebruik je het",
            "tekst": "<p>Wax: begin met een basislaag en wax daarna in kleine rondjes tot je goede grip hebt. Kies je wax op de watertemperatuur.</p><p>Stickers: plak ze op een schoon en droog oppervlak.</p>",
            "toon": "surfgear"
          }
        }
      },
