        "punt-1": {
          "type": "punt",
          "settings": {
            "tekst": "Past op softtops en vollere boards én op hardboards"
          }
        },
        "punt-2": {
          "type": "punt",
          "settings": {
            "tekst": "Gewicht goed verdeeld over je rug, niet op één schouder"
          }
        },
        "punt-3": {
          "type": "punt",
          "settings": {
            "tekst": "Je natte board hoeft niet vol zand in een dichte hoes"
          }
        },
        "detail-4": {
          "type": "detail",
          "settings": {
            "titel": "Wat past erin",
            "tekst": "<p>Eén universele maat. Van de grote softtop waar je op leert surfen tot je hardboard voor de verstopte spot.</p>"
          }
        },
        "detail-5": {
          "type": "detail",
          "settings": {
            "titel": "Materiaal",
            "tekst": "<p>Zware, waterbestendige stof, sterke stiksels en stevige gespen. Gemaakt om jaren mee te gaan, niet voor één zomer.</p>"
          }
        },
        "detail-6": {
          "type": "detail",
          "settings": {
            "titel": "Verzending en retour",
            "tekst": "<p>We versturen door heel Europa. Past hij toch niet bij je? Je hebt 14 dagen bedenktijd.</p>"
          }
        }
      },
      "block_order": [
        "punt-1",
