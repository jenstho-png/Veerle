{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "features": {
      "type": "surf-features",
      "settings": {
        "color_scheme": "scheme-2",
        "heading": "Waarom surfers *hem dragen*"
      },
      "blocks": {
        "feature-1": {
          "type": "feature",
          "settings": {
            "icon": "backpack",
            "title": "Draagt als een rugzak",
            "text": "Ergonomische banden verdelen het gewicht over je rug. Lange hikes zonder pijnlijke schouders."
          }
        },
        "feature-2": {
          "type": "feature",
          "settings": {
            "icon": "shield",
            "title": "Zwaar weer-bestendig",
            "text": "Robuuste stof en dubbele stiksels die tegen nat, zand, zout en een flinke stoot kunnen."
          }
        },
        "feature-3": {
          "type": "feature",
          "settings": {
            "icon": "bike",
            "title": "Handen vrij op de weg",
            "text": "Board op je rug, handen aan het stuur. Op de fiets of scooter naar de spot, zonder gegoochel."
          }
        },
        "feature-4": {
          "type": "feature",
          "settings": {
            "icon": "plane",
            "title": "Reist met je mee",
            "text": "Opgevouwen klein genoeg voor je bagage. Huur je ter plekke een board? Je tas is er al."
          }
        }
      },
      "block_order": [
        "feature-1",
        "feature-2",
        "feature-3",
        "feature-4"
      ]
    },
    "faq": {
      "type": "surf-faq",
      "settings": {
        "btn_link": "shopify://pages/contact"
      },
      "blocks": {
        "qa-1": {
          "type": "qa",
          "settings": {
            "question": "Welke surfboards passen in de tas?",
            "answer": "<p>Ons kernmodel heeft een universele maat: hij past om de grotere, vollere softtops van beginners én om de meeste hardboards van gevorderde surfers.</p>"
          }
        },
        "qa-2": {
          "type": "qa",
          "settings": {
            "question": "Kan ik de tas meenemen in het vliegtuig?",
            "answer": "<p>Ja. De tas vouw je klein op, zodat hij gewoon in je bagage past. Huur je op je bestemming een board, dan neem je die met jouw tas mee naar de spot.</p>"
          }
        },
        "qa-3": {
          "type": "qa",
          "settings": {
            "question": "Kan ik ermee fietsen of op de scooter?",
            "answer": "<p>Daar is hij juist voor gemaakt. Het board hangt op je rug, zodat je beide handen vrij hebt voor je stuur.</p>"
          }
        },
        "qa-4": {
          "type": "qa",
          "settings": {
            "question": "Mag mijn board nat en zanderig de tas in?",
            "answer": "<p>Ja. De stof kan tegen water, zout en zand. Spoel de tas af en toe na met zoet water en laat hem goed drogen.</p>"
          }
        },
        "qa-5": {
          "type": "qa",
          "settings": {
            "question": "Wat is het verschil met een boardbag?",
            "answer": "<p>Een boardbag is een dichte hoes die je board beschermt tijdens transport. Onze tas is gemaakt om je board te dragen: open, licht en met ergonomische banden voor lange tochten naar de spot.</p>"
          }
        }
      },
      "block_order": [
        "qa-1",
        "qa-2",
        "qa-3",
        "qa-4",
        "qa-5"
      ]
    }
  },
  "order": [
    "main",
    "features",
    "disclosures",
    "faq",
    "related-products"
  ]
}