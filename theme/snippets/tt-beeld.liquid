{%- comment -%}
  Beeld met sfeerfoto als plaatsvervanger.
  1. Gekozen foto in de editor  2. Bestand met `filename` in Content > Bestanden  3. Sfeerfoto uit de thema-assets (`fallback`, zonder .jpg).
  Gebruik: {% render 'tt-beeld', image: section.settings.image, filename: 'x.jpg', fallback: 'tt-foto-strand', alt: '...', sizes: '50vw' %}
{%- endcomment -%}
{%- liquid
  assign img = image
  if img == blank and filename != blank
    assign img = images[filename]
  endif
  assign alt_text = alt | default: img.alt | default: shop.name
  assign sizes = sizes | default: '100vw'
  assign laad = loading | default: 'lazy'
-%}
{%- if img != blank -%}
  {%- if laad == 'eager' -%}
    {{ img | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: sizes, widths: '480, 750, 1100, 1500, 1800, 2400', alt: alt_text, class: 'tt-beeld__img' }}
  {%- else -%}
    {{ img | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: sizes, widths: '480, 750, 1100, 1500, 1800, 2400', alt: alt_text, class: 'tt-beeld__img' }}
  {%- endif -%}
{%- elsif fallback != blank -%}
  {%- assign klein = fallback | append: '-800.jpg' | asset_url -%}
  {%- assign groot = fallback | append: '.jpg' | asset_url -%}
  <img class="tt-beeld__img" src="{{ groot }}" width="1600" height="1600" srcset="{{ klein }} 800w, {{ groot }} 1600w" sizes="{{ sizes }}" alt="{{ alt_text | escape }}" loading="{{ laad }}"{% if laad == 'eager' %} fetchpriority="high"{% endif %} decoding="async">
  {%- if filename != blank -%}<span class="tt-beeld__naam">{{ filename }}</span>{%- endif -%}
{%- else -%}
  <span class="tt-beeld__leeg" role="img" aria-label="{{ alt_text | escape }}">{%- render 'tt-logo', variant: 'maan-simpel' -%}</span>
{%- endif -%}
