{%- comment -%}
  Beeld met sfeervolle plaatsvervanger.
  1. Gekozen foto in de editor  2. Bestand met `filename` in Content > Bestanden  3. Getekende scène (`scene`).
  Scènes: zee, duin, onder, avond, nacht, palm, boards, tas
  Gebruik: {% render 'tt-beeld', image: block.settings.image, filename: 'x.jpg', scene: 'zee', alt: '...', sizes: '50vw' %}
{%- endcomment -%}
{%- liquid
  assign img = image
  if img == blank and filename != blank
    assign img = images[filename]
  endif
  assign alt_text = alt | default: img.alt | default: shop.name
  assign sizes = sizes | default: '100vw'
  assign scene = scene | default: 'zee'
-%}
{%- if img != blank -%}
  {%- if loading == 'eager' -%}
    {{ img | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: sizes, widths: '480, 750, 1100, 1500, 1800, 2400', alt: alt_text, class: 'tt-beeld__img' }}
  {%- else -%}
    {{ img | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: sizes, widths: '480, 750, 1100, 1500, 1800, 2400', alt: alt_text, class: 'tt-beeld__img' }}
  {%- endif -%}
{%- else -%}
  <svg class="tt-scene" viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" role="img" aria-label="{{ alt_text | escape }}">
    {%- case scene -%}
      {%- when 'duin' -%}
        <defs><linearGradient id="ttg-duin-l" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#A9C9EA"/><stop offset=".6" stop-color="#EBDDC6"/><stop offset="1" stop-color="#F3D9B8"/></linearGradient><linearGradient id="ttg-duin-z" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F6CDA9"/><stop offset="1" stop-color="#E9A47C"/></linearGradient></defs>
        <rect width="400" height="500" fill="url(#ttg-duin-l)"/><circle cx="118" cy="150" r="42" fill="#F7F0E2" opacity=".95"/>
        <path d="M0 300c70-60 150-70 230-30s120 10 170-20v250H0z" fill="url(#ttg-duin-z)"/><path d="M0 382c90-40 190-30 270 0s100 10 130 0v118H0z" fill="#E7AE88"/>
        <g stroke="#3E5F86" stroke-width="4" stroke-linecap="round" opacity=".45"><path d="M58 302l-6-42M78 298l2-46M98 304l9-38M298 262l-4-30M312 264l4-28"/></g>
      {%- when 'onder' -%}
        <defs><linearGradient id="ttg-onder" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5D8FCF"/><stop offset="1" stop-color="#10284A"/></linearGradient></defs>
        <rect width="400" height="500" fill="url(#ttg-onder)"/><path d="M120 0l-70 500M205 0l12 500M300 0l80 500" stroke="#C4DAF0" stroke-width="34" opacity=".12"/>
        <g fill="#DCEAF7" opacity=".7"><circle cx="150" cy="300" r="6"/><circle cx="162" cy="268" r="4"/><circle cx="154" cy="240" r="3"/><circle cx="270" cy="200" r="4"/><circle cx="276" cy="176" r="2.5"/></g>
        <g fill="none" stroke="#F2BDBD" stroke-width="12" stroke-linecap="round" opacity=".85"><path d="M300 500c0-30-4-50 0-80M300 450c-20-4-34-20-30-46M300 430c16-10 28-26 26-50"/></g>
        <g fill="none" stroke="#F2D06B" stroke-width="9" stroke-linecap="round" opacity=".7"><path d="M80 500c0-24 4-40-2-62M80 470c12-6 22-18 20-36"/></g>
      {%- when 'avond' -%}
        <defs><linearGradient id="ttg-avond" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F2BDBD"/><stop offset=".6" stop-color="#F4A27E"/><stop offset="1" stop-color="#EE7B4F"/></linearGradient></defs>
        <rect width="400" height="320" fill="url(#ttg-avond)"/><circle cx="200" cy="300" r="72" fill="#F2D06B"/><rect y="300" width="400" height="200" fill="#1F3F6B"/>
        <g fill="none" stroke="#F2D06B" stroke-width="4" stroke-linecap="round" opacity=".65"><path d="M146 330h108M164 350h72M180 370h40"/></g>
      {%- when 'nacht' -%}
        <rect width="400" height="500" fill="#1F3F6B"/>
        <g transform="translate(210 64) scale(.62)" fill="#F5EEDF">{%- render 'tt-logo', variant: 'maan-simpel-pad' -%}</g>
        <rect y="318" width="400" height="182" fill="#18325A"/>
        <g fill="none" stroke="#C4DAF0" stroke-width="3" stroke-linecap="round" opacity=".45"><path d="M40 346c14 0 14-6 28-6s14 6 28 6M200 366c14 0 14-6 28-6s14 6 28 6 14-6 28-6M90 406c18 0 18-8 36-8s18 8 36 8"/></g>
        <path d="M250 330h110M262 346h80" stroke="#F5EEDF" stroke-width="3" stroke-linecap="round" opacity=".35"/>
      {%- when 'palm' -%}
        <defs><filter id="ttf-zacht" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="7"/></filter><linearGradient id="ttg-muur" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F7EFE2"/><stop offset="1" stop-color="#EBDCC4"/></linearGradient></defs>
        <rect width="400" height="500" fill="url(#ttg-muur)"/>
        <g filter="url(#ttf-zacht)" opacity=".38" fill="#8E7A62" transform="rotate(-18 200 250)">
          <path d="M60 520C110 380 190 250 320 120" stroke="#8E7A62" stroke-width="10" fill="none"/>
          {%- for i in (1..9) -%}
            {%- assign t = i | times: 38 -%}
            <ellipse cx="{{ 90 | plus: t }}" cy="{{ 470 | minus: t }}" rx="70" ry="13" transform="rotate(-35 {{ 90 | plus: t }} {{ 470 | minus: t }})"/>
            <ellipse cx="{{ 120 | plus: t }}" cy="{{ 500 | minus: t }}" rx="64" ry="12" transform="rotate(48 {{ 120 | plus: t }} {{ 500 | minus: t }})"/>
          {%- endfor -%}
        </g>
      {%- when 'boards' -%}
        <defs><linearGradient id="ttg-boards" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#C4DAF0"/><stop offset="1" stop-color="#F3E5CC"/></linearGradient></defs>
        <rect width="400" height="500" fill="url(#ttg-boards)"/><rect y="420" width="400" height="80" fill="#EBD3B0"/>
        <g transform="rotate(-6 120 260)"><path d="M120 60c34 70 34 290 0 380-34-90-34-310 0-380z" fill="#F5EEDF"/><path d="M120 80v350" stroke="#1F3F6B" stroke-width="2" opacity=".25"/></g>
        <g transform="rotate(4 210 250)"><path d="M210 40c40 80 40 310 0 400-40-90-40-320 0-400z" fill="#EE7B4F"/><path d="M210 60v370" stroke="#F5EEDF" stroke-width="2" opacity=".5"/></g>
        <g transform="rotate(10 300 270)"><path d="M300 90c30 60 30 270 0 350-30-80-30-290 0-350z" fill="#3D6FB6"/><path d="M300 110v320" stroke="#F5EEDF" stroke-width="2" opacity=".45"/></g>
      {%- when 'tas' -%}
        <defs><linearGradient id="ttg-tas" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F3E7D3"/><stop offset="1" stop-color="#E9D6B8"/></linearGradient></defs>
        <rect width="400" height="500" fill="url(#ttg-tas)"/>
        <ellipse cx="200" cy="420" rx="150" ry="18" fill="#C9AE88" opacity=".45"/>
        <g transform="rotate(-58 200 250)">
          <path d="M40 250C80 200 300 192 368 250 300 308 80 300 40 250z" fill="#F7F1E6" stroke="#1F3F6B" stroke-width="3"/>
          <path d="M58 250C96 218 290 212 350 250" fill="none" stroke="#1F3F6B" stroke-width="1.5" stroke-dasharray="3 5" opacity=".45"/>
          <path d="M126 210v80M282 212v76" stroke="#1F3F6B" stroke-width="24" stroke-linecap="round"/>
          <path d="M126 214C142 120 268 120 282 214" fill="none" stroke="#EE7B4F" stroke-width="12" stroke-linecap="round"/>
          <rect x="188" y="130" width="30" height="18" rx="4" fill="#F2D06B" stroke="#1F3F6B" stroke-width="1.5"/>
          <circle cx="204" cy="250" r="30" fill="#1F3F6B"/>
          <g transform="translate(180 226) scale(.24)" fill="#F5EEDF">{%- render 'tt-logo', variant: 'maan-simpel-pad' -%}</g>
        </g>
      {%- else -%}
        <defs><linearGradient id="ttg-zee-l" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9DC1E6"/><stop offset=".55" stop-color="#E9DCC6"/><stop offset="1" stop-color="#F3D9B8"/></linearGradient><linearGradient id="ttg-zee-z" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3D6FB6"/><stop offset="1" stop-color="#1F3F6B"/></linearGradient></defs>
        <rect width="400" height="300" fill="url(#ttg-zee-l)"/><circle cx="290" cy="252" r="48" fill="#F2D06B" opacity=".92"/><rect y="270" width="400" height="230" fill="url(#ttg-zee-z)"/>
        <g fill="none" stroke="#C4DAF0" stroke-width="3" stroke-linecap="round" opacity=".55"><path d="M20 310c14 0 14-6 28-6s14 6 28 6M140 330c14 0 14-6 28-6s14 6 28 6 14-6 28-6M260 300c14 0 14-6 28-6s14 6 28 6"/><path d="M40 380c18 0 18-8 36-8s18 8 36 8 18-8 36-8M220 400c18 0 18-8 36-8s18 8 36 8 18-8 36-8"/></g>
        <path d="M0 450c40-22 80-22 120-6s90 18 140 0 100-20 140-4v60H0z" fill="#F5EEDF" opacity=".88"/>
    {%- endcase -%}
  </svg>
  {%- if filename != blank -%}<span class="tt-beeld__naam">{{ filename }}</span>{%- endif -%}
{%- endif -%}
