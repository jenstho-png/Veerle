{%- comment -%} Microsoft Clarity, alleen na toestemming voor analytische cookies (Shopify cookiemelding). {%- endcomment -%}
{%- if settings.tt_clarity != blank -%}
<script>
  (function () {
    var id = {{ settings.tt_clarity | strip | json }};
    var geladen = false;
    function laad() {
      if (geladen) return; geladen = true;
      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
        t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', id);
    }
    function check() {
      var cp = window.Shopify && window.Shopify.customerPrivacy;
      if (!cp || typeof cp.analyticsProcessingAllowed !== 'function' || cp.analyticsProcessingAllowed()) laad();
    }
    document.addEventListener('visitorConsentCollected', function (e) { if (e.detail && e.detail.analyticsAllowed) laad(); });
    if (window.Shopify && typeof window.Shopify.loadFeatures === 'function') {
      window.Shopify.loadFeatures([{ name: 'consent-tracking-api', version: '0.1' }], function (fout) { if (fout) laad(); else check(); });
    } else {
      laad();
    }
  })();
</script>
{%- endif -%}
